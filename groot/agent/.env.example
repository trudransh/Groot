LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

DEEPGRAM_API_KEY=

ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_MODEL=glm-5.3-flash

# Voice (TTS) via OpenRouter
OPENROUTER_API_KEY=
# OPENROUTER_TTS_MODEL=x-ai/grok-voice-tts-1.0
# OPENROUTER_TTS_VOICE=eve


# Must match the client's LIVEKIT_AGENT_NAME
LIVEKIT_AGENT_NAME=groot

# ESP32 pump (station/esp32-pump/pump_wifi)
PUMP_URL=http://172.20.10.2
PUMP_TOKEN=
# Calibrate: millilitres the pump moves per second
PUMP_ML_PER_SECOND=20
# MIN_HOURS_BETWEEN_WATERINGS=6
# Critical thirst (collapsed leaves, cracked soil) may drink again after this many hours
# CRITICAL_MIN_HOURS_BETWEEN_WATERINGS=1

# Groot's wallet: the address is derived from this key and shown on the Wallet card. Never commit it.
GROOT_PRIVATE_KEY=
# Worker health port; give each local instance its own (see run-two.sh)
# AGENT_HTTP_PORT=8081

# Sepolia RPC for the wallet (balances, transfers)
SEPOLIA_RPC_URL=
# SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
DEEPGRAM_LANGUAGE=en
# World ID app that verifies recipients outside the forest
WORLDCOIN_APP_URL=https://plants.salts.dev
# Reservoir server the pump MCP reports each run to (scripts/ens: pnpm reservoir)
# RESERVOIR_URL=http://127.0.0.1:8790
