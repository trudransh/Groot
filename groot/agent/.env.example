LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
# Optional, default z-ai/glm-5.3-flash
# LLM_MODEL=

# Optional: ElevenLabs voice. Without it, TTS falls back to OpenRouter.
ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=
# OPENROUTER_TTS_MODEL=x-ai/grok-voice-tts-1.0
# OPENROUTER_TTS_VOICE=eve

# Must match the client's LIVEKIT_AGENT_NAME
LIVEKIT_AGENT_NAME=groot

# ESP32 pump (station/esp32-pump/pump_wifi)
PUMP_URL=http://172.20.10.2
PUMP_TOKEN=
# Calibrate: millilitres the pump moves per second
PUMP_ML_PER_SECOND=20
# Vision model that looks at the plant photo (OpenRouter)
# VISION_MODEL=google/gemini-2.5-flash
# MIN_HOURS_BETWEEN_WATERINGS=6
